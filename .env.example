# web app (.env.local)
# written by `pnpm dev:convex`; points at the local or cloud deployment
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# convex deployment env (set with `npx convex env set NAME value`, not in .env.local)
# issuer domain of the clerk "convex" jwt template, e.g. https://example.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# comma separated emails that become admin on first sign-in
ADMIN_EMAILS=admin@example.com
# public origin of the web app, used for links in notifications
APP_URL=http://localhost:3000
# n8n webhook that receives loan status changes
N8N_LOAN_STATUS_WEBHOOK_URL=http://n8n:5678/webhook/lendloop/loan-status
# hmac secret for convex -> n8n payloads (also set in the n8n container)
LENDLOOP_OUTBOUND_SECRET=
# hmac secret for n8n -> convex requests (also set in the n8n container)
LENDLOOP_INBOUND_SECRET=

# n8n container env
# convex http actions origin as seen from the n8n container
LENDLOOP_CONVEX_SITE_URL=http://convex-backend:3211
# recipient of workflow failure alerts
LENDLOOP_ALERT_EMAIL=alerts@example.com
GENERIC_TIMEZONE=UTC
